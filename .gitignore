/third_party/stylegan2-ada-pytorch/

# Local environments and caches.
/.venv/
/env/
__pycache__/
*.py[cod]
.pytest_cache/
.pycache_tmp/
.idea/
.vscode/

# Tool state directories.
/.ta-research-afp/
/.review/

# Large and generated experiment artifacts.
/*.tar.gz
/data/raw/
/data/downloads/
/data/processed/
/checkpoints/*
!/checkpoints/README.md
/results/runs/
/results/logs/*
