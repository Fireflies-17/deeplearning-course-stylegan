% Course report style copied from report/course_materials/报告模板.doc.
% Build with XeLaTeX on Windows/TeX Live so SimSun, DengXian, Times New Roman,
% and Courier New are available.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{course_report_style}[2026/06/21 Word course report clone]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{course_report_style}{This template must be compiled with XeLaTeX}{Use: xelatex <file>.tex}
\fi

\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage[
  paperwidth=8.5in,
  paperheight=11in,
  left=0.75in,
  right=0.75in,
  top=0.98in,
  bottom=0.98in,
  headheight=0pt,
  headsep=0pt,
  footskip=32pt
]{geometry}
\RequirePackage{multicol}
\RequirePackage{indentfirst}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{fancyhdr}
\RequirePackage{xparse}
\RequirePackage{etoolbox}
\RequirePackage{enumitem}
\RequirePackage{fvextra}
\RequirePackage{ragged2e}
\RequirePackage{xurl}
\RequirePackage{seqsplit}

% Word document defaults with TeX Live fallbacks for Overleaf.
\IfFontExistsTF{Times New Roman}
  {\setmainfont{Times New Roman}}
  {\setmainfont{TeX Gyre Termes}}
\IfFontExistsTF{DengXian}
  {%
    \setCJKmainfont[AutoFakeBold=2.4,AutoFakeSlant=0.15]{DengXian}%
    \setCJKmonofont{DengXian}%
  }
  {%
    \setCJKmainfont[AutoFakeBold=2.4,AutoFakeSlant=0.15]{FandolHei-Regular}%
    \setCJKmonofont{FandolHei-Regular}%
  }
\IfFontExistsTF{Arial}
  {\setsansfont{Arial}}
  {\setsansfont{TeX Gyre Heros}}
\IfFontExistsTF{Courier New}
  {\setmonofont{Courier New}}
  {\setmonofont{TeX Gyre Cursor}}
\IfFontExistsTF{SimSun}
  {%
    \newfontfamily\reporttitlelatin[AutoFakeBold=2.4]{SimSun}%
    \newCJKfontfamily\reporttitlecjk[AutoFakeBold=2.4]{SimSun}%
  }
  {%
    \newfontfamily\reporttitlelatin[AutoFakeBold=2.4]{TeX Gyre Termes}%
    \newCJKfontfamily\reporttitlecjk[AutoFakeBold=2.4]{FandolSong-Regular}%
  }

\xeCJKsetup{
  CJKspace=true,
  CheckSingle=true,
  PunctStyle=plain
}

\makeatletter
\renewcommand\normalsize{%
  \@setfontsize\normalsize{10pt}{13.56pt}%
  \abovedisplayskip 6pt plus 2pt minus 2pt%
  \abovedisplayshortskip 4pt plus 2pt minus 2pt%
  \belowdisplayshortskip 4pt plus 2pt minus 2pt%
  \belowdisplayskip \abovedisplayskip
}
\makeatother
\normalsize

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{\fontsize{12pt}{12pt}\selectfont\thepage}

\setlength{\parindent}{12.25pt}
\setlength{\parskip}{0pt}
\setlength{\columnsep}{17.3pt}
\setlength{\columnseprule}{0pt}
\setlength{\multicolsep}{0pt}
\setlength{\emergencystretch}{1em}
\raggedcolumns
\sloppy
\urlstyle{tt}

\captionsetup{
  font={bf,normalsize},
  labelfont=bf,
  labelsep=quad,
  justification=centering,
  singlelinecheck=false,
  skip=6pt
}

\setlist{
  nosep,
  leftmargin=13.5pt,
  itemindent=0pt,
  labelsep=4pt,
  topsep=0pt,
  partopsep=0pt,
  parsep=0pt
}

\NewDocumentCommand{\reporttitlefont}{}{%
  \reporttitlelatin\reporttitlecjk\fontsize{12pt}{14pt}\selectfont\bfseries
}
\NewDocumentCommand{\reportauthorfont}{}{%
  \fontsize{12pt}{14pt}\selectfont
}
\NewDocumentCommand{\reportsectionfont}{}{%
  \reporttitlecjk\fontsize{9.96pt}{13.56pt}\selectfont\bfseries
}
\NewDocumentCommand{\reportsubsectionfont}{}{%
  \fontsize{12pt}{13.56pt}\selectfont\bfseries
}
\NewDocumentCommand{\reportcaptionfont}{}{%
  \fontsize{9.96pt}{13.56pt}\selectfont\bfseries
}
\NewDocumentCommand{\reportcodefont}{}{%
  \ttfamily\fontsize{10pt}{12pt}\selectfont
}

\NewDocumentCommand{\reportmaketitle}{m m}{%
  \thispagestyle{fancy}%
  \vspace*{17pt}%
  {\centering\reporttitlefont #1\par}%
  \vspace{29.5pt}%
  {\centering\reportauthorfont #2\par}%
  \vspace{23.5pt}%
}

\NewDocumentEnvironment{reportbody}{}%
  {\begin{multicols}{2}}%
  {\end{multicols}}

\NewDocumentCommand{\reportpagebreak}{}{%
  \par\end{multicols}%
  \clearpage%
  \begin{multicols}{2}%
}

\NewDocumentCommand{\reportsection}{m}{%
  \par\addvspace{10pt}%
  {\centering\reportsectionfont #1\par}%
  \vspace{4pt}%
}

\NewDocumentCommand{\reportsubsection}{m}{%
  \par\addvspace{9pt}%
  {\raggedright\reportsubsectionfont #1\par}%
  \vspace{3pt}%
}

\NewDocumentCommand{\reportsubsubsection}{m}{%
  \par\addvspace{8pt}%
  {\raggedright\reportsubsectionfont #1\par}%
  \vspace{3pt}%
}

\NewDocumentCommand{\reportkeywords}{m}{%
  \par\noindent\hspace*{\parindent}关键词—\quad #1\par
}

\NewDocumentCommand{\reportpara}{m}{%
  \par #1\par
}

\NewDocumentCommand{\reportwideblock}{+m}{%
  \par\end{multicols}%
  \vspace{6pt}%
  \noindent #1\par%
  \vspace{6pt}%
  \begin{multicols}{2}%
}

\NewDocumentCommand{\reportimage}{O{0.95\linewidth} m m}{%
  \par\noindent\begin{minipage}{\linewidth}
  \centering
    \includegraphics[width=#1]{#2}
    \par\vspace{3pt}{\reportcaptionfont #3\par}
  \end{minipage}\par\vspace{7pt}%
}

\NewDocumentEnvironment{reportcode}{}%
  {\VerbatimEnvironment\begin{Verbatim}[fontsize=\reportcodefont, breaklines=true, breaksymbolleft={}]}%
  {\end{Verbatim}}

\newcolumntype{Y}{>{\centering\arraybackslash}X}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\renewcommand{\arraystretch}{1.18}
\setlength{\tabcolsep}{4pt}

\NewDocumentEnvironment{reporttable}{m m}%
  {\begin{center}\reportcaptionfont #1\par\vspace{3pt}\fontsize{9pt}{11pt}\selectfont\begin{tabular*}{\linewidth}{@{\extracolsep{\fill}}#2}}%
  {\end{tabular*}\end{center}}

\NewDocumentEnvironment{reportwidetable}{m m}%
  {\par\end{multicols}\vspace{6pt}\begin{center}\reportcaptionfont #1\par\vspace{3pt}\fontsize{9pt}{11pt}\selectfont\begin{tabularx}{\linewidth}{#2}}%
  {\end{tabularx}\end{center}\vspace{6pt}\begin{multicols}{2}}

\NewDocumentCommand{\reportwideimage}{O{0.82\linewidth} m m}{%
  \par\end{multicols}%
  \begin{center}
    \includegraphics[width=#1]{#2}
    \par\vspace{3pt}{\reportcaptionfont #3\par}
  \end{center}
  \vspace{7pt}%
  \begin{multicols}{2}%
}
